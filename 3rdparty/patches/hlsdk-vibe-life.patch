+/*
+==================
+CGlock::VRDropMagazine
+
+Reuses GoldSrc MOVETYPE_BOUNCE physics for the ejected magazine. This avoids a
+second physics world for a single short-lived prop; Box3D remains reserved for
+the full hand/magazine interaction pass.
+==================
+*/
+void CGlock::VRDropMagazine( void )
+{
+#if !CLIENT_DLL
+	Vector vecOrigin = m_pPlayer->GetGunPosition();
+	Vector vecAngles = m_pPlayer->pev->v_angle;
+
+	// The muzzle sits ahead of the magwell; drop the magazine below and behind it.
+	vecOrigin = vecOrigin - gpGlobals->v_forward * 5.0f - gpGlobals->v_up * 6.0f;
+	vecOrigin = vecOrigin + gpGlobals->v_right * 2.0f;
+
+	CBaseEntity *pMag = CBaseEntity::Create( "info_target", vecOrigin, vecAngles, NULL );
+	if( !pMag )
+		return;
+
+	SET_MODEL( ENT( pMag->pev ), "models/w_9mmclip.mdl" );
+	UTIL_SetSize( pMag->pev, Vector( -1.0f, -1.0f, -1.0f ), Vector( 1.0f, 1.0f, 1.0f ) );
+	pMag->pev->movetype = MOVETYPE_BOUNCE;
+	pMag->pev->solid = SOLID_BBOX;
+	pMag->pev->gravity = 1.0f;
+	pMag->pev->friction = 0.8f;
+	pMag->pev->velocity = m_pPlayer->pev->vuser3 * 0.25f;
+	pMag->pev->velocity.z -= 80.0f;
+	pMag->pev->velocity = pMag->pev->velocity + gpGlobals->v_right * 30.0f;
+	pMag->pev->avelocity = Vector( 0.0f, 0.0f, 180.0f );
+	pMag->pev->nextthink = gpGlobals->time + 15.0f;
+	pMag->SetThink( &CBaseEntity::SUB_Remove );
+#endif
+}
+
+/*
+==================
+CGlock::VRManualReloadThink
+
+Staged manual reload for the Glock:
+  1. B ejects the current magazine.
+  2. B inserts a fresh magazine from reserve.
+  3. B racks the slide and completes the reload.
+
+The spatial off-hand gate will replace the second and third B presses once the
+off-hand magwell/slide flags are exposed by the engine. Keeping the staged
+fallback makes the feature usable with every controller and accessibility mode.
+==================
+*/
+bool CGlock::VRManualReloadThink( void )
+{
+#if CLIENT_DLL
+	return false;
+#else
+	if( CVAR_GET_FLOAT( "vr_manual_reload" ) <= 0.0f )
+	{
+		m_iVrReloadStage = 0;
+		return false;
+	}
+
+	const bool pressed = ( m_pPlayer->m_afButtonPressed & IN_RELOAD ) != 0;
+	const float now = UTIL_WeaponTimeBase();
+
+	if( m_iVrReloadStage == 0 )
+	{
+		if( !pressed )
+			return false;
+		if( m_iClip <= 0 && m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 )
+			return false;
+
+		m_iVrSavedClip = m_iClip;
+		m_iClip = 0;
+		m_iVrReloadStage = 1;
+		m_fInReload = TRUE;
+		m_pPlayer->m_flNextAttack = now + 0.35f;
+		SendWeaponAnim( GLOCK_RELOAD, 0 );
+		EMIT_SOUND_DYN( ENT( m_pPlayer->pev ), CHAN_ITEM, "items/9mmclip2.wav", 1.0f, ATTN_NORM, 0, 100 );
+		VRDropMagazine();
+
+		if( CVAR_GET_FLOAT( "vr_debug_reload" ) > 0.0f )
+			ALERT( at_console, "[VR_RELOAD] manual eject %s clip=%d reserve=%d\n",
+				STRING( pev->classname ), m_iClip, m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] );
+		return true;
+	}
+
+	// Stages 1 and 2 consume the weapon frame until the player advances them.
+	if( now < m_pPlayer->m_flNextAttack )
+		return true;
+
+	if( !pressed )
+		return true;
+
+	if( m_iVrReloadStage == 1 )
+	{
+		if( m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] <= 0 )
+		{
+			m_iClip = m_iVrSavedClip;
+			m_iVrSavedClip = 0;
+			m_iVrReloadStage = 0;
+			m_fInReload = FALSE;
+			if( CVAR_GET_FLOAT( "vr_debug_reload" ) > 0.0f )
+				ALERT( at_console, "[VR_RELOAD] manual abort %s (no reserve ammo)\n", STRING( pev->classname ));
+			return true;
+		}
+
+		m_iVrReloadStage = 2;
+		m_pPlayer->m_flNextAttack = now + 0.35f;
+		SendWeaponAnim( GLOCK_RELOAD, 0 );
+		EMIT_SOUND_DYN( ENT( m_pPlayer->pev ), CHAN_ITEM, "items/9mmclip1.wav", 1.0f, ATTN_NORM, 0, 100 );
+		if( CVAR_GET_FLOAT( "vr_debug_reload" ) > 0.0f )
+			ALERT( at_console, "[VR_RELOAD] manual insert %s stage=2\n", STRING( pev->classname ));
+		return true;
+	}
+
+	// Final stage: seat the magazine, then rack the slide.
+	{
+		int take = Q_min( iMaxClip() - m_iClip, m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] );
+		m_iClip += take;
+		m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] -= take;
+
+		// Keep the rounds from the ejected magazine in reserve instead of
+		// silently deleting them.
+		if( m_iVrSavedClip > 0 )
+		{
+			int cap = iMaxAmmo1();
+			int &reserve = m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType];
+			reserve = Q_min( cap, reserve + m_iVrSavedClip );
+			m_iVrSavedClip = 0;
+		}
+
+		m_pPlayer->TabulateAmmo();
+		m_iVrReloadStage = 0;
+		m_fInReload = FALSE;
+		m_pPlayer->m_flNextAttack = now + 0.15f;
+		m_flTimeWeaponIdle = now + 1.0f;
+		SendWeaponAnim( GLOCK_RELOAD_NOT_EMPTY, 0 );
+		EMIT_SOUND_DYN( ENT( m_pPlayer->pev ), CHAN_ITEM, "weapons/pl_gun3.wav", 0.7f, ATTN_NORM, 0, 100 );
+
+		if( CVAR_GET_FLOAT( "vr_debug_reload" ) > 0.0f )
+			ALERT( at_console, "[VR_RELOAD] manual complete %s clip=%d reserve=%d\n",
+				STRING( pev->classname ), m_iClip, m_pPlayer->m_rgAmmo[m_iPrimaryAmmoType] );
+		return true;
+	}
+#endif
+}
