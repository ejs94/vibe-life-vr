+void CGlock::ItemPostFrame( void )
+{
+#if !CLIENT_DLL
+	if( ( m_pPlayer->m_afButtonPressed & IN_RELOAD ) && CVAR_GET_FLOAT( "vr_debug_reload" ) > 0.0f )
+		ALERT( at_console, "[VR_RELOAD] glock itempost cvar=%.1f stage=%d clip=%d\n",
+			CVAR_GET_FLOAT( "vr_manual_reload" ), m_iVrReloadStage, m_iClip );
+	if( VRManualReloadThink( ))
+		return;
+#endif
+	CBasePlayerWeapon::ItemPostFrame();
+}
