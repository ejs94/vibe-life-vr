+// VR off-hand grab: find the closest item/weapon around the hand position and
+// pick it up through the same Touch() path used by walking over it.
+static qboolean VR_IsGrabbableClassname( const char *pszClassname )
+{
+	if( !pszClassname )
+		return false;
+
+	return ( !strncmp( pszClassname, "item_", 5 ) ||
+	         !strncmp( pszClassname, "weapon_", 7 ) ||
+	         !strncmp( pszClassname, "ammo_", 5 ) ||
+	         FStrEq( pszClassname, "weaponbox" ));
+}
+
+static void VR_GrabCommand( edict_t *pEntity )
+{
+	if( CMD_ARGC() < 4 )
+		return;
+
+	if( CVAR_GET_FLOAT( "vr_offhand_grab" ) <= 0.0f )
+		return;
+
+	CBasePlayer *pPlayer = GetClassPtr( (CBasePlayer *)&pEntity->v );
+	if( !pPlayer || !pPlayer->IsAlive( ))
+		return;
+
+	Vector hand( atof( CMD_ARGV( 1 )), atof( CMD_ARGV( 2 )), atof( CMD_ARGV( 3 )));
+
+	// Reject spoofed positions far away from the player.
+	if( ( hand - pPlayer->pev->origin ).Length() > 140.0f )
+		return;
+
+	CBaseEntity *pBest = NULL;
+	float bestDist = 99999.0f;
+
+	for( CBaseEntity *pEnt = UTIL_FindEntityInSphere( NULL, hand, 30.0f );
+	     pEnt; pEnt = UTIL_FindEntityInSphere( pEnt, hand, 30.0f ))
+	{
+		if( pEnt == pPlayer || pEnt->pev->solid == SOLID_NOT )
+			continue;
+		if( FBitSet( pEnt->pev->flags, FL_KILLME ))
+			continue;
+
+		const char *pszClassname = STRING( pEnt->pev->classname );
+		if( !VR_IsGrabbableClassname( pszClassname ))
+			continue;
+
+		// Do not grab through walls.
+		TraceResult tr;
+		UTIL_TraceLine( pPlayer->EyePosition(), pEnt->pev->origin, ignore_monsters, pEnt->edict(), &tr );
+		if( tr.flFraction < 0.95f && !tr.fStartSolid )
+			continue;
+
+		float dist = ( pEnt->pev->origin - hand ).Length();
+		if( dist < bestDist )
+		{
+			bestDist = dist;
+			pBest = pEnt;
+		}
+	}
+
+	if( pBest )
+	{
+		if( CVAR_GET_FLOAT( "vr_debug_grab" ) > 0.0f )
+			ALERT( at_console, "[VR_GRAB] picking %s at %.1f\n",
+				STRING( pBest->pev->classname ), bestDist );
+
+		pBest->Touch( pPlayer );
+	}
+	else if( CVAR_GET_FLOAT( "vr_debug_grab" ) > 0.0f )
+	{
+		ALERT( at_console, "[VR_GRAB] nothing in reach at %.1f %.1f %.1f\n",
+			hand.x, hand.y, hand.z );
+	}
+}
+
 /*
 ===========
 ClientCommand
@@ -601,6 +676,41 @@ void ClientCommand( edict_t *pEntity )
 		if( pPlayer->IsObserver() )
 			pPlayer->Observer_FindNextPlayer( atoi( CMD_ARGV( 1 ) ) ? true : false );
 	}
+	else if( FStrEq( pcmd, "vr_grab" ) )
+	{
+		VR_GrabCommand( pEntity );
+	}
+	else if( FStrEq( pcmd, "vr_test_teleport" ) )
+	{
+		// Test-only helper for the ladder regression, gated by vr_debug_ladder.
