+
+void CMenuSlider::Setup( float minValue, float maxValue, float range )
+{
+	m_flMinValue = minValue;
+	m_flMaxValue = maxValue;
+	m_flRange = range;
+	if( m_flRange < 0.001f )
+		m_flRange = 0.001f;
+
+	m_flCurValue = SnapAndBound( m_flCurValue );
+}
+
+void CMenuSlider::SetCurrentValue( float curValue )
+{
+	m_flCurValue = SnapAndBound( curValue );
+	if( !m_bEditing )
+	{
+		FormatValue( m_flCurValue, m_szEditBuffer, sizeof( m_szEditBuffer ) );
+	}
+}
+
+float CMenuSlider::SnapAndBound( float val )
+{
+	float clamped = bound( m_flMinValue, val, m_flMaxValue );
+	if( m_flRange <= 0.0001f )
+		return clamped;
+
+	float steps = roundf( ( clamped - m_flMinValue ) / m_flRange );
+	float snapped = m_flMinValue + steps * m_flRange;
+	snapped = bound( m_flMinValue, snapped, m_flMaxValue );
+
+	// Avoid IEEE 754 precision drift (e.g. 89.799999 or 90.000008)
+	if( m_flRange >= 1.0f )
+		snapped = roundf( snapped );
+	else if( m_flRange >= 0.1f )
+		snapped = roundf( snapped * 10.0f ) / 10.0f;
+	else if( m_flRange >= 0.01f )
+		snapped = roundf( snapped * 100.0f ) / 100.0f;
+	else
+		snapped = roundf( snapped * 1000.0f ) / 1000.0f;
+
+	return snapped;
+}
+
+void CMenuSlider::FormatValue( float val, char *buffer, size_t bufSize )
+{
+	if( m_flRange >= 1.0f )
+		V_snprintf( buffer, bufSize, "%.0f", val );
+	else if( m_flRange >= 0.1f )
+		V_snprintf( buffer, bufSize, "%.1f", val );
+	else if( m_flRange >= 0.01f )
+		V_snprintf( buffer, bufSize, "%.2f", val );
+	else
+		V_snprintf( buffer, bufSize, "%.3f", val );
+}
+
+void CMenuSlider::UpdateLayout()
+{
+	if( m_scSize.h < 20 * uiStatic.scaleY )
+		m_scSize.h = 20 * uiStatic.scaleY;
+
+	int H = m_scSize.h;
+	int W = m_scSize.w;
+	int Y = m_scPos.y;
+	int gap = (int)( 6 * uiStatic.scaleX );
+	if( gap < 4 ) gap = 4;
+
+	int btnW = H;
+	int valBoxW = (int)( 62 * uiStatic.scaleX );
+	if( valBoxW < 56 ) valBoxW = 56;
+
+	// Scale down buttons and numeric box if row width is constrained
+	if( btnW * 2 + valBoxW + gap * 3 > W - 40 )
+	{
+		btnW = Q_max( 16, W / 8 );
+		valBoxW = Q_max( 46, W / 4 );
+	}
+
+	m_scLeftArrowPos = Point( m_scPos.x, Y );
+	m_scLeftArrowSize = Size( btnW, H );
+
+	int trackX = m_scLeftArrowPos.x + btnW + gap;
+	int trackW = ( m_scPos.x + W ) - trackX - ( btnW + gap + valBoxW + gap );
+	if( trackW < 30 ) trackW = 30;
+
+	m_scTrackPos = Point( trackX, Y );
+	m_scTrackSize = Size( trackW, H );
+
+	int rightX = trackX + trackW + gap;
+	m_scRightArrowPos = Point( rightX, Y );
+	m_scRightArrowSize = Size( btnW, H );
+
+	int valX = rightX + btnW + gap;
+	m_scValBoxPos = Point( valX, Y );
+	m_scValBoxSize = Size( ( m_scPos.x + W ) - valX, H );
+
+	// Scale the center thumb box
+	m_scCenterBox.w = (int)( 24 * uiStatic.scaleX );
+	if( m_scCenterBox.w < 16 ) m_scCenterBox.w = 16;
+	m_scCenterBox.h = H - m_iSliderOutlineWidth * 2;
+	if( m_scCenterBox.h < 4 ) m_scCenterBox.h = 4;
+
+	m_iNumSteps = ( m_flMaxValue - m_flMinValue ) / m_flRange + 1;
+	m_flDrawStep = (float)( m_scTrackSize.w - m_scCenterBox.w ) / (float)m_iNumSteps;
 }
 
