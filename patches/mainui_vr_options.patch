+/*
+=================
+CMenuVR::Think
+=================
+*/
+void CMenuVR::Think( void )
+{
+	CMenuFramework::Think();
+
+	// Support programmatic or console-driven tab selection via vr_menu_tab
+	int tabVal = (int)EngFuncs::GetCvarFloat( "vr_menu_tab" );
+	if( tabVal >= 0 && tabVal < 4 && tabVal != tabView.GetCursor() )
+	{
+		tabView.SetCursor( tabVal );
+	}
+}
