+void CMenuSlider::StepLeft()
+{
+	if( m_flCurValue <= m_flMinValue )
+	{
+		PlayLocalSound( uiStatic.sounds[SND_BUZZ] );
+		return;
+	}
+
+	float steps = roundf( ( m_flCurValue - m_flMinValue ) / m_flRange );
+	float nextVal = m_flMinValue + ( steps - 1.0f ) * m_flRange;
+	m_flCurValue = SnapAndBound( nextVal );
+
+	SetCvarValue( m_flCurValue );
+	_Event( QM_CHANGED );
+	PlayLocalSound( uiStatic.sounds[SND_KEY] );
+}
+
+void CMenuSlider::StepRight()
+{
+	if( m_flCurValue >= m_flMaxValue )
+	{
+		PlayLocalSound( uiStatic.sounds[SND_BUZZ] );
+		return;
+	}
 
-	m_iNumSteps = (m_flMaxValue - m_flMinValue) / m_flRange + 1;
-	m_flDrawStep = (float)(m_scSize.w - m_iSliderOutlineWidth - m_scCenterBox.w) / (float)m_iNumSteps;
+	float steps = roundf( ( m_flCurValue - m_flMinValue ) / m_flRange );
+	float nextVal = m_flMinValue + ( steps + 1.0f ) * m_flRange;
+	m_flCurValue = SnapAndBound( nextVal );
+
+	SetCvarValue( m_flCurValue );
+	_Event( QM_CHANGED );
+	PlayLocalSound( uiStatic.sounds[SND_KEY] );
+}
+
+void CMenuSlider::StartEditing()
+{
+	m_bEditing = true;
+	m_bEditFirstChar = true;
+	FormatValue( m_flCurValue, m_szEditBuffer, sizeof( m_szEditBuffer ) );
+	PlayLocalSound( uiStatic.sounds[SND_KEY] );
+}
+
+void CMenuSlider::CommitEdit()
+{
+	if( !m_bEditing )
+		return;
+
+	m_bEditing = false;
+	if( m_szEditBuffer[0] != '\0' && strcmp( m_szEditBuffer, "-" ) != 0 )
+	{
+		float val = (float)atof( m_szEditBuffer );
+		m_flCurValue = SnapAndBound( val );
+		SetCvarValue( m_flCurValue );
+		_Event( QM_CHANGED );
+		PlayLocalSound( uiStatic.sounds[SND_KEY] );
+	}
+	else
+	{
+		FormatValue( m_flCurValue, m_szEditBuffer, sizeof( m_szEditBuffer ) );
+	}
+}
+
+void CMenuSlider::CancelEdit()
+{
+	m_bEditing = false;
+	FormatValue( m_flCurValue, m_szEditBuffer, sizeof( m_szEditBuffer ) );
 }
 
