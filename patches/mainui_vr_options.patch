+#include "build.h"
+#include "Framework.h"
+#include "Bitmap.h"
+#include "PicButton.h"
+#include "Slider.h"
+#include "CheckBox.h"
+#include "SpinControl.h"
+#include "Action.h"
+
+#define ART_BANNER "gfx/shell/head_advanced"
+
+class CMenuVR : public CMenuFramework
+{
+public:
+	CMenuVR() : CMenuFramework( "CMenuVR" ) { }
+
+private:
+	void _Init() override;
+	void _VidInit() override;
+	void GetConfig();
+	void SaveAndPopMenu() override;
+
+	void ToggleSmoothTurn();
+
+	// Section labels
+	CMenuAction labelLocomotion;
+	CMenuAction labelWeapons;
+	CMenuAction labelCalibration;
+
+	// Locomotion & Comfort
+	CMenuCheckBox smoothturn;
+	CMenuSpinControl snapAngle;
+	CMenuCheckBox walkdirection;
+
+	// Immersion & Weapons
+	CMenuCheckBox lasersight;
+	CMenuCheckBox headtorch;
+	CMenuCheckBox lefthanded;
+	CMenuCheckBox haptics;
+	CMenuCheckBox pointerHud;
+
+	// Calibration & World Scale
+	CMenuSlider weaponPitch;
+	CMenuSlider worldscale;
+	CMenuSlider heightAdjust;
+};
+
+/*
+=================
+CMenuVR::ToggleSmoothTurn
+=================
+*/
+void CMenuVR::ToggleSmoothTurn( void )
+{
+	snapAngle.SetGrayed( smoothturn.bChecked );
+}
+
+/*
+=================
+CMenuVR::GetConfig
+=================
+*/
+void CMenuVR::GetConfig( void )
+{
+	smoothturn.LinkCvar( "vr_smoothturn" );
+	snapAngle.LinkCvar( "vr_snap_angle", CMenuEditable::CVAR_VALUE );
+	walkdirection.LinkCvar( "vr_walkdirection" );
+
+	lasersight.LinkCvar( "vr_lasersight" );
+	headtorch.LinkCvar( "vr_headtorch" );
+	lefthanded.LinkCvar( "vr_lefthanded" );
+	haptics.LinkCvar( "vr_haptics_enabled" );
+	pointerHud.LinkCvar( "vr_pointer_hud" );
+
+	weaponPitch.LinkCvar( "vr_weapon_pitchadjust" );
+	worldscale.LinkCvar( "vr_worldscale" );
+	heightAdjust.LinkCvar( "vr_height_adjust" );
+
+	ToggleSmoothTurn();
+}
+
+/*
+=================
+CMenuVR::SaveAndPopMenu
+=================
+*/
+void CMenuVR::SaveAndPopMenu( void )
+{
+	smoothturn.WriteCvar();
+	snapAngle.WriteCvar();
+	walkdirection.WriteCvar();
+
+	lasersight.WriteCvar();
+	headtorch.WriteCvar();
+	lefthanded.WriteCvar();
+	haptics.WriteCvar();
+	pointerHud.WriteCvar();
+
+	weaponPitch.WriteCvar();
+	worldscale.WriteCvar();
+	heightAdjust.WriteCvar();
+
+	CMenuFramework::SaveAndPopMenu();
+}
+
+/*
+=================
+CMenuVR::_Init
+=================
+*/
+void CMenuVR::_Init( void )
+{
+	banner.SetPicture( ART_BANNER );
+
+	// Headers
+	labelLocomotion.szName = L( "Locomotion & Comfort" );
+	labelLocomotion.iFlags = QMF_INACTIVE | QMF_DROPSHADOW;
+	labelLocomotion.colorBase = uiColorHelp;
+
+	labelWeapons.szName = L( "Weapons & Flashlight" );
+	labelWeapons.iFlags = QMF_INACTIVE | QMF_DROPSHADOW;
+	labelWeapons.colorBase = uiColorHelp;
+
+	labelCalibration.szName = L( "Calibration & Scale" );
+	labelCalibration.iFlags = QMF_INACTIVE | QMF_DROPSHADOW;
+	labelCalibration.colorBase = uiColorHelp;
+
+	// Locomotion & Comfort controls
+	smoothturn.SetNameAndStatus( L( "Smooth Turning" ), L( "Continuous smooth turning instead of snap turning" ) );
+	smoothturn.onChanged = VoidCb( &CMenuVR::ToggleSmoothTurn );
+
+	snapAngle.SetNameAndStatus( L( "Snap Turn Angle" ), L( "Degrees turned per snap turn flick (15 to 90 deg)" ) );
+	snapAngle.Setup( 15.0f, 90.0f, 15.0f );
+	snapAngle.SetDisplayPrecision( 0 );
+
+	walkdirection.SetNameAndStatus( L( "Controller Walk Direction" ), L( "Move toward controller orientation instead of head gaze" ) );
+
+	// Immersion & Weapon controls
+	lasersight.SetNameAndStatus( L( "3D Weapon Laser Sight" ), L( "Visible laser pointer projected from weapon barrel" ) );
+	headtorch.SetNameAndStatus( L( "Head-Mounted Flashlight" ), L( "Flashlight attaches to head instead of off-hand" ) );
+	lefthanded.SetNameAndStatus( L( "Left-Handed Primary Weapon" ), L( "Hold primary weapon in left hand" ) );
+	haptics.SetNameAndStatus( L( "Haptic Vibration Feedback" ), L( "Tactile recoil and environmental sensations in controllers" ) );
+	pointerHud.SetNameAndStatus( L( "Menu Laser Pointer" ), L( "Interact with VR menus using laser pointer virtual cursor" ) );
+
+	// Calibration & World scale sliders
+	weaponPitch.SetNameAndStatus( L( "Weapon Pitch Offset" ), L( "Adjust weapon barrel angle in degrees (-30 to +30)" ) );
+	weaponPitch.Setup( -30.0f, 30.0f, 1.0f );
+
+	worldscale.SetNameAndStatus( L( "VR World Scale" ), L( "World scale units per meter (default: 40)" ) );
+	worldscale.Setup( 20.0f, 60.0f, 1.0f );
+
+	heightAdjust.SetNameAndStatus( L( "Player Height Offset" ), L( "Vertical player height calibration (-20 to +20)" ) );
+	heightAdjust.Setup( -20.0f, 20.0f, 1.0f );
+
+	// Side buttons
+	AddItem( banner );
+	AddButton( L( "Done" ), nullptr, PC_DONE, VoidCb( &CMenuVR::SaveAndPopMenu ) );
+	AddButton( L( "GameUI_Cancel" ), nullptr, PC_CANCEL, VoidCb( &CMenuFramework::Hide ) );
+
+	// Controls registration
+	AddItem( labelLocomotion );
+	AddItem( smoothturn );
+	AddItem( snapAngle );
+	AddItem( walkdirection );
+
+	AddItem( labelWeapons );
+	AddItem( lasersight );
+	AddItem( headtorch );
+	AddItem( lefthanded );
+	AddItem( haptics );
+	AddItem( pointerHud );
+
+	AddItem( labelCalibration );
+	AddItem( weaponPitch );
+	AddItem( worldscale );
+	AddItem( heightAdjust );
+}
+
+/*
+=================
+CMenuVR::_VidInit
+=================
+*/
+void CMenuVR::_VidInit( void )
+{
+	int lx = 330;
+	int ly = 230;
+
+	// Locomotion & Comfort column
+	labelLocomotion.SetCoord( lx, ly );
+	ly += 40;
+
+	smoothturn.SetCoord( lx, ly );
+	ly += 45;
+
+	snapAngle.SetRect( lx, ly + 15, 230, 30 );
+	ly += 65;
+
+	walkdirection.SetCoord( lx, ly );
+	ly += 55;
+
+	// Weapons & Flashlight
+	labelWeapons.SetCoord( lx, ly );
+	ly += 35;
+
+	lasersight.SetCoord( lx, ly );
+	ly += 38;
+
+	headtorch.SetCoord( lx, ly );
+	ly += 38;
+
+	lefthanded.SetCoord( lx, ly );
+	ly += 38;
+
+	haptics.SetCoord( lx, ly );
+	ly += 38;
+
+	pointerHud.SetCoord( lx, ly );
+
+	// Right column: Calibration & World Scale
+	int rx = 660;
+	int ry = 230;
+
+	labelCalibration.SetCoord( rx, ry );
+	ry += 60;
+
+	weaponPitch.SetCoord( rx, ry );
+	weaponPitch.size.w = 280;
+	ry += 80;
+
+	worldscale.SetCoord( rx, ry );
+	worldscale.size.w = 280;
+	ry += 80;
+
+	heightAdjust.SetCoord( rx, ry );
+	heightAdjust.size.w = 280;
+
+	GetConfig();
+}
+
+ADD_MENU( menu_vr, CMenuVR, UI_VR_Menu );
