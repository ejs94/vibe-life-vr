+bool CMenuTabView::MouseMove( int x, int y )
+{
+	// Check if cursor is hovering over the tab headers
+	Point tabOffset = m_scPos;
+	FOR_EACH_VEC( m_pItems, i )
+	{
+		if( UI_CursorInRect( tabOffset, m_szTab ) )
+		{
+			return true;
+		}
+		tabOffset.x += m_szTab.w;
+	}
+
+	// Forward mouse move only to the currently active tab item
+	if( m_iCursor >= 0 && m_iCursor < m_pItems.Count() )
+	{
+		CMenuBaseItem *activeItem = m_pItems[m_iCursor];
+		if( activeItem && activeItem->IsVisible() && !FBitSet( activeItem->iFlags, QMF_INACTIVE ) )
+		{
+			return activeItem->MouseMove( x, y );
+		}
+	}
+
+	return false;
+}
+
+bool CMenuTabView::KeyDown( int key )
+{
+	// Click on tab header bar
+	if( key == K_MOUSE1 )
+	{
+		Point tabOffset = m_scPos;
+		FOR_EACH_VEC( m_pItems, i )
+		{
+			if( UI_CursorInRect( tabOffset, m_szTab ) )
+			{
+				if( m_iCursor != i )
+				{
+					SetCursor( i );
+					PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+				}
+				return true;
+			}
+			tabOffset.x += m_szTab.w;
+		}
+	}
+
+	// Tab cycle hotkeys (PageUp / PageDown or brackets)
+	if( key == K_PGDN || key == ']' )
+	{
+		if( m_pItems.Count() > 1 )
+		{
+			SetCursor( ( m_iCursor + 1 ) % m_pItems.Count() );
+			PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+			return true;
+		}
+	}
+	else if( key == K_PGUP || key == '[' )
+	{
+		if( m_pItems.Count() > 1 )
+		{
+			SetCursor( ( m_iCursor - 1 + m_pItems.Count() ) % m_pItems.Count() );
+			PlayLocalSound( uiStatic.sounds[SND_LAUNCH] );
+			return true;
+		}
+	}
+
+	// Forward to active tab item
+	if( m_iCursor >= 0 && m_iCursor < m_pItems.Count() )
+	{
+		CMenuBaseItem *activeItem = m_pItems[m_iCursor];
+		if( activeItem && activeItem->IsVisible() && !FBitSet( activeItem->iFlags, QMF_INACTIVE ) )
+		{
+			if( activeItem->KeyDown( key ) )
+				return true;
+		}
+	}
+
+	return false;
+}
+
+bool CMenuTabView::KeyUp( int key )
+{
+	if( m_iCursor >= 0 && m_iCursor < m_pItems.Count() )
+	{
+		CMenuBaseItem *activeItem = m_pItems[m_iCursor];
+		if( activeItem && activeItem->IsVisible() && !FBitSet( activeItem->iFlags, QMF_INACTIVE ) )
+		{
+			return activeItem->KeyUp( key );
+		}
+	}
+	return false;
+}
+
+void CMenuTabView::Char( int key )
+{
+	if( m_iCursor >= 0 && m_iCursor < m_pItems.Count() )
+	{
+		CMenuBaseItem *activeItem = m_pItems[m_iCursor];
+		if( activeItem && activeItem->IsVisible() && !FBitSet( activeItem->iFlags, QMF_INACTIVE ) )
+		{
+			activeItem->Char( key );
+		}
+	}
+}
