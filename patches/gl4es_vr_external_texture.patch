+
+void gl4es_registerExternalTexture(GLuint texture, int width, int height) {
+    if (!texture) return;
+    int ret;
+    khint_t k = kh_get(tex, glstate->texture.list, texture);
+    gltexture_t *t = NULL;
+    if (k == kh_end(glstate->texture.list)) {
+        k = kh_put(tex, glstate->texture.list, texture, &ret);
+        t = kh_value(glstate->texture.list, k) = (gltexture_t*)malloc(sizeof(gltexture_t));
+        memset(t, 0, sizeof(gltexture_t));
+        t->texture = texture;
+    } else {
+        t = kh_value(glstate->texture.list, k);
+    }
+    t->glname = texture;
+    t->target = GL_TEXTURE_2D;
+    t->width = width;
+    t->height = height;
+    t->nwidth = width;
+    t->nheight = height;
+    t->adjustxy[0] = 1.0f;
+    t->adjustxy[1] = 1.0f;
+    t->format = GL_RGBA;
+    t->type = GL_UNSIGNED_BYTE;
+}
