<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:paddingHorizontal="8dp"
	android:paddingTop="4dp"
	android:paddingBottom="8dp">

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:text="@string/test_map_picker_title"
		android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
		android:textColor="@color/horizon_text_primary"
		android:textStyle="bold" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:layout_marginBottom="12dp"
		android:text="@string/test_map_picker_subtitle"
		android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
		android:textColor="@color/horizon_text_secondary" />

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardCrossfire"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/horizon_surface"
		app:cardCornerRadius="14dp"
		app:strokeColor="@color/horizon_border"
		app:strokeWidth="1dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="16dp">

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginEnd="16dp"
				android:contentDescription="@string/test_map_crossfire_title"
				android:src="@drawable/ic_games_24"
				app:tint="@color/horizon_primary" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/test_map_crossfire_title"
					android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
					android:textColor="@color/horizon_text_primary"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="@string/test_map_crossfire_desc"
					android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
					android:textColor="@color/horizon_text_secondary" />
			</LinearLayout>

			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_marginStart="8dp"
				android:contentDescription="@string/play_in_vr"
				android:src="@drawable/ic_baseline_play_arrow_24"
				app:tint="@color/horizon_primary" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardTestbed"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/horizon_surface"
		app:cardCornerRadius="14dp"
		app:strokeColor="@color/horizon_border"
		app:strokeWidth="1dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="16dp">

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginEnd="16dp"
				android:contentDescription="@string/test_map_testbed_title"
				android:src="@drawable/ic_diagnostics_24"
				app:tint="@color/horizon_primary" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/test_map_testbed_title"
					android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
					android:textColor="@color/horizon_text_primary"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="@string/test_map_testbed_desc"
					android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
					android:textColor="@color/horizon_text_secondary" />
			</LinearLayout>

			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_marginStart="8dp"
				android:contentDescription="@string/play_in_vr"
				android:src="@drawable/ic_baseline_play_arrow_24"
				app:tint="@color/horizon_primary" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

	<com.google.android.material.card.MaterialCardView
		android:id="@+id/cardHazard"
		style="@style/Widget.Material3.CardView.Filled"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:clickable="true"
		android:focusable="true"
		app:cardBackgroundColor="@color/horizon_surface"
		app:cardCornerRadius="14dp"
		app:strokeColor="@color/horizon_border"
		app:strokeWidth="1dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:padding="16dp">

			<ImageView
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:layout_marginEnd="16dp"
				android:contentDescription="@string/test_map_hazard_title"
				android:src="@drawable/ic_vr_headset_24"
				app:tint="@color/horizon_primary" />

			<LinearLayout
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:orientation="vertical">

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/test_map_hazard_title"
					android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
					android:textColor="@color/horizon_text_primary"
					android:textStyle="bold" />

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="2dp"
					android:text="@string/test_map_hazard_desc"
					android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
					android:textColor="@color/horizon_text_secondary" />
			</LinearLayout>

			<ImageView
				android:layout_width="24dp"
				android:layout_height="24dp"
				android:layout_marginStart="8dp"
				android:contentDescription="@string/play_in_vr"
				android:src="@drawable/ic_baseline_play_arrow_24"
				app:tint="@color/horizon_primary" />
		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>
</LinearLayout>
