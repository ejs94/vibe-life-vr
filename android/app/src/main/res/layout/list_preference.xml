<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	style="@style/Widget.Material3.CardView.Filled"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:layout_marginHorizontal="8dp"
	android:layout_marginTop="8dp"
	app:cardBackgroundColor="@color/horizon_surface"
	app:cardCornerRadius="14dp"
	app:strokeColor="@color/horizon_border"
	app:strokeWidth="1dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:minHeight="64dp"
		android:orientation="vertical"
		android:paddingHorizontal="16dp"
		android:paddingVertical="12dp">

		<TextView
			android:id="@android:id/title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
			android:textColor="@color/horizon_text_primary"
			tools:text="List preference" />

		<TextView
			android:id="@android:id/summary"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="2dp"
			android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
			android:textColor="@color/horizon_text_secondary"
			tools:text="Selected value" />
	</LinearLayout>
</com.google.android.material.card.MaterialCardView>
